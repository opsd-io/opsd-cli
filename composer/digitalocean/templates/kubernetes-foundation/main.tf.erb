terraform {
  required_version = ">= 1.11.0"

  required_providers {
    digitalocean = {
      source  = "digitalocean/digitalocean"
      version = "~> 2.78"
    }
  }
}

provider "digitalocean" {
  token = var.digitalocean_token
}

<% postgres_databases = manifest.databases.select { |database| database.fetch("engine") == "postgres" } %>
<% postgres_module_names = postgres_databases.each_index.map { |index| index.zero? ? "postgres" : "postgres_#{index + 1}" } %>
<% project_optional_urns = [] %>
<% project_optional_urns << "module.redis.urn" if manifest.primary_cache %>
<% project_optional_urns.concat(postgres_module_names.map { |name| "module.#{name}.urn" }) %>

module "vpc" {
  count  = var.create_vpc ? 1 : 0
  source = "<%= module_package_root %>//modules/vpc"

  name        = var.vpc_name
  region      = var.region
  description = var.vpc_description
  ip_range    = var.vpc_ip_range
}

locals {
  vpc_uuid_effective = var.create_vpc ? module.vpc[0].id : var.vpc_uuid
  project_resource_urns = concat(
    var.create_vpc ? [
      module.kubernetes.urn,
      module.vpc[0].urn
    ] : [
      module.kubernetes.urn
    ],
    [<%= project_optional_urns.join(", ") %>]
  )
}

<% postgres_databases.each_with_index do |database, index| %>
<% module_name = index.zero? ? "postgres" : "postgres_#{index + 1}" %>
<% database_config = database.fetch("config", {}) %>
module "<%= module_name %>" {
  source = "<%= module_package_root %>//modules/managed-postgres"

  name                 = "<%= manifest.metadata_name %>-<%= database.fetch("id") %>"
  postgres_version     = "<%= database.fetch("version", "16") %>"
  region               = var.region
  size                 = "<%= profile_value(database.fetch("profile", "db-s-1vcpu-1gb")) %>"
  node_count           = <%= database_config.fetch("node_count", 1) %>
  private_network_uuid = local.vpc_uuid_effective
  tags                 = var.cluster_tags
  database_name       = "<%= database_config.fetch("database_name", "app") %>"
  app_user_name        = "<%= database_config.fetch("app_user_name", "app") %>"
}
<% end %>

module "kubernetes" {
  source = "<%= module_package_root %>//modules/kubernetes"

  name                   = var.cluster_name
  region                 = var.region
  kubernetes_version     = var.kubernetes_version
  vpc_uuid               = local.vpc_uuid_effective
  tags                   = var.cluster_tags
  auto_upgrade           = var.auto_upgrade
  surge_upgrade          = var.surge_upgrade
  ha                     = var.ha
  node_pool_name         = var.node_pool_name
  node_size              = var.node_size
  node_count             = var.node_count
  node_auto_scale        = var.node_auto_scale
  node_min_nodes         = var.node_min_nodes
  node_max_nodes         = var.node_max_nodes
  node_tags              = var.node_tags
  node_labels            = var.node_labels
  maintenance_day        = var.maintenance_day
  maintenance_start_time = var.maintenance_start_time
  maintenance_duration   = var.maintenance_duration
}

<% if manifest.primary_cache %>
module "redis" {
  source = "<%= module_package_root %>//modules/managed-redis"

  name                 = "<%= manifest.metadata_name %>-redis"
  redis_version        = "<%= manifest.primary_cache.fetch("version", "7") %>"
  region               = var.region
  size                 = "<%= profile_value(manifest.primary_cache.fetch("profile", "db-s-1vcpu-1gb")) %>"
  node_count           = <%= manifest.primary_cache_config.fetch("node_count", 1) %>
  private_network_uuid = local.vpc_uuid_effective
  tags                 = var.cluster_tags
}
<% end %>

module "project" {
  source = "<%= module_package_root %>//modules/project"

  name          = var.project_name
  description   = var.project_description
  purpose       = var.project_purpose
  environment   = var.project_environment
  resource_urns = local.project_resource_urns
}
