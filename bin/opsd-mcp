#!/bin/sh
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
APP_ROOT="$(CDPATH= cd -- "${SCRIPT_DIR}/.." && pwd)"

if [ -x "${APP_ROOT}/runtime/bin/ruby" ]; then
  RUBY_BIN="${APP_ROOT}/runtime/bin/ruby"
else
  RUBY_BIN="${RUBY_BIN:-ruby}"
fi

export OPSD_APP_ROOT="${OPSD_APP_ROOT:-${APP_ROOT}}"
export OPSD_WORKSPACE_ROOT="${OPSD_WORKSPACE_ROOT:-${OPSD_APP_ROOT}}"

case "${1:-}" in
  config)
    shift
    exec "${RUBY_BIN}" --disable-gems -I"${APP_ROOT}/lib" -ropsd/mcp_config -e 'OPSd::McpConfig.run(ARGV, app_root: ENV.fetch("OPSD_APP_ROOT"), workspace_root: ENV.fetch("OPSD_WORKSPACE_ROOT"))' -- "$@"
    ;;
  ""|serve)
    exec "${RUBY_BIN}" --disable-gems -I"${APP_ROOT}/lib" -ropsd/mcp_server -e 'OPSd::McpServer.new(app_root: ENV.fetch("OPSD_APP_ROOT"), workspace_root: ENV.fetch("OPSD_WORKSPACE_ROOT")).run' -- "$@"
    ;;
  *)
    exec "${RUBY_BIN}" --disable-gems -I"${APP_ROOT}/lib" -ropsd/mcp_server -e 'OPSd::McpServer.new(app_root: ENV.fetch("OPSD_APP_ROOT"), workspace_root: ENV.fetch("OPSD_WORKSPACE_ROOT")).run' -- "$@"
    ;;
esac
